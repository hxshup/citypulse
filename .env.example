# Local API/database settings. Keep provider credentials server-side only.
CITYPULSE_DB_PATH=.data/citypulse.sqlite

# Required on Vercel for durable, shared storage. Create a MongoDB Atlas
# database user and add the cluster connection string in Vercel's env settings.
MONGODB_URI=
MONGODB_DATABASE=citypulse

# Optional free-tier TomTom Traffic API key. Traffic is clearly marked
# unavailable in the UI until a key is configured.
TOMTOM_API_KEY=

# Optional AI-generated, evidence-grounded explanation layer.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
